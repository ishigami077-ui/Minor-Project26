# ==============================================================================
# Kisan Setu - Digital Agricultural Marketplace & Mechanization Platform
# Environment Configuration Template
# ==============================================================================

# Official Open Government Data Platform India (data.gov.in) API Key
# Used for real-time live APMC Mandi commodity rates (Agmarknet dataset).
# 1. Register for a free account at https://data.gov.in/
# 2. Navigate to "My Account" -> "API Key" to copy your 40-character key.
# 3. Paste it here:
VITE_DATAGOV_API_KEY=

# Optional: Custom Mandi Proxy/Relay URL if self-hosting or using a custom proxy
# Defaults to https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# VITE_MANDI_API_URL=

# Live Weather Service Configuration
# Default: Open-Meteo API (High-accuracy ECMWF/IMD meteorological model)
# No API key required for Open-Meteo.
# If you prefer to integrate OpenWeatherMap or WeatherAPI in production:
# VITE_WEATHER_API_KEY=
